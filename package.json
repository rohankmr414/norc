{
  "name": "cron-cal",
  "productName": "Cron",
  "version": "1.108.0",
  "homepage": "https://www.cron.com",
  "private": true,
  "description": "Cron",
  "main": "build/main/main.js",
  "author": {
    "name": "Cron Inc.",
    "email": "hello@cron.com"
  },
  "engines": {
    "node": "16.x"
  },
  "build": {
    "productName": "cron-cal",
    "appId": "com.cron.electron",
    "files": [
      "node_modules/**/*",
      "package.json",
      "build/main/*",
      "build/preload/*"
    ],
    "directories": {
      "output": "dist/release"
    },
    "linux": {
      "icon": "build/main/logo.png"
    }
  },
  "scripts": {
    "build": "electron-builder build --linux deb"
  },
  "prettier": {
    "printWidth": 120
  },
  "dependencies": {
    "@dnd-kit/core": "3.1.1",
    "@dnd-kit/sortable": "4.0.0",
    "@dnd-kit/utilities": "3.0.2",
    "@googlemaps/js-api-loader": "1.12.12",
    "@sentry/browser": "6.16.1",
    "@sentry/electron": "2.5.4",
    "@sentry/integrations": "6.16.1",
    "@todesktop/runtime": "0.6.5",
    "analytics-node": "6.0.0",
    "assert": "2.0.0",
    "autolinker": "3.14.3",
    "axios": "0.24.0",
    "buffer": "6.0.3",
    "chrono-node": "1.4.8",
    "command-score": "0.1.2",
    "compare-versions": "4.1.2",
    "compression": "^1.7.4",
    "cuid": "2.1.8",
    "d3-cam02": "0.1.5",
    "d3-color": "3.0.1",
    "date-fns": "2.28.0",
    "date-fns-tz": "1.2.2",
    "electron-context-menu": "3.1.1",
    "electron-store": "5.2.0",
    "electron-util": "0.17.2",
    "electron-window-state": "5.0.3",
    "eventemitter3": "4.0.7",
    "express": "4.17.2",
    "framer-motion": "4.1.17",
    "html-react-parser": "1.4.4",
    "http-status-codes": "2.2.0",
    "humanize-duration": "3.27.1",
    "idb": "7.0.0",
    "lodash": "4.17.21",
    "mobx": "6.3.10",
    "mobx-react-lite": "3.2.3",
    "node-machine-id": "1.1.12",
    "parse-duration": "1.0.2",
    "polished": "4.1.3",
    "process": "0.11.10",
    "qs": "6.10.2",
    "quill": "1.3.7",
    "quill-delta": "4.2.2",
    "react": "17.0.2",
    "react-day-picker": "7.4.10",
    "react-dom": "17.0.2",
    "react-focus-lock": "2.7.1",
    "react-helmet": "6.1.0",
    "react-quill": "2.0.0-beta.4",
    "react-router-dom": "5.3.0",
    "react-virtual": "2.10.0",
    "reconnecting-websocket": "4.4.0",
    "rrule": "2.6.8",
    "shortid": "2.2.16",
    "styled-components": "5.3.3",
    "uuid-random": "1.3.2",
    "workbox-core": "6.4.2",
    "workbox-precaching": "6.4.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "organize-imports-cli",
      "prettier --write"
    ],
    "*.{css,md}": "prettier --write"
  },
  "devDependencies": {
    "electron": "^16.0.7",
    "electron-builder": "^22.14.5"
